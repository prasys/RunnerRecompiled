+  /**
+   * \brief Deferred destruction of Vulkan resources
+   *
+   * MoltenVK on Metal residency sets creates its Metal command buffers
+   * without retained references and keeps every live buffer and texture
+   * in one residency set attached to the queue. Destroying a Vulkan
+   * resource removes it from that set and releases the Metal object at
+   * once, while command buffers committed before the removal can still
+   * be executing; Metal then fails them with "Invalid Resource" and the
+   * device is lost. Timeline semaphores do not help either, since they
+   * are signalled from the GPU before Metal considers a command buffer
+   * complete.
+   *
+   * When enabled, images, buffers, their views and device memory are
+   * only destroyed once all queue work that was submitted before the
+   * destroy request has completed, as observed through fences that
+   * MoltenVK signals from Metal completion handlers.
+   */
+  class DxvkDeferredDestroy {
+
+  public:
+
+    DxvkDeferredDestroy(
+      const Rc<vk::DeviceFn>&           vkd,
+            bool                        enable)
+    : m_vkd(vkd), m_enabled(enable) {
+      if (const char* m = std::getenv("DXVK_DEFER_MARGIN")) m_margin = std::strtoull(m, nullptr, 10);
+    }
+
+    ~DxvkDeferredDestroy() {
+      flushAll();
+    }
+
+    bool enabled() const {
+      return m_enabled;
+    }
+
+    /**
+     * \brief Starts a queue submission
+     *
+     * Must be called before the submission is handed to the
+     * driver, so that destroy requests racing with it wait
+     * for it as well.
+     * \returns Sequence number of the submission
+     */
+    uint64_t beginSubmission() {
+      return ++m_submitted;
+    }
+
+    /**
+     * \brief Destroys or defers destruction of an object
+     *
+     * \param [in] type Object type
+     * \param [in] handle Object handle
+     */
+    void destroy(VkObjectType type, uint64_t handle) {
+      if (!handle)
+        return;
+
+      if (!m_enabled) {
+        destroyNow(type, handle);
+        return;
+      }
+
+      std::lock_guard lock(m_mutex);
+      m_entries.push_back({ type, handle, m_submitted.load() });
+
+    }
+
+    /**
+     * \brief Marks submissions as complete
+     *
+     * Destroys every object whose destroy request came before
+     * submission \c seq + 1. All submissions up to and including
+     * \c seq must have completed.
+     * \param [in] seq Last completed submission
+     */
+    void complete(uint64_t seq) {
+      std::vector<Entry> ready;
+
+      { std::lock_guard lock(m_mutex);
+        if (seq != ~0ull) m_completed = seq;
+
+        while (!m_entries.empty() && (seq == ~0ull || m_entries.front().seq + m_margin <= seq)) {
+          ready.push_back(m_entries.front());
+          m_entries.pop_front();
+        }
+      }
+
+      for (const auto& e : ready) {
+        destroyNow(e.type, e.handle);
+      }
+    }
+
+    /**
+     * \brief Destroys all deferred objects
+     *
+     * Only safe once the device is idle.
+     */
+    void flushAll() {
+      complete(~0ull);
+    }
+
+  private:
+
+    struct Entry {
+      VkObjectType  type;
+      uint64_t      handle;
+      uint64_t      seq;
+    };
+
+    Rc<vk::DeviceFn>      m_vkd;
+    bool                  m_enabled;
+
+    std::atomic<uint64_t> m_submitted = { 0ull };
+    uint64_t              m_completed = 0ull;
+    uint64_t              m_margin = 0ull;
+
+    void dbg(const char* what, uint64_t handle, uint64_t a, uint64_t b) {
+      timeval tv; gettimeofday(&tv, nullptr);
+      std::fprintf(stderr, "[defer] %ld.%03d %s memory 0x%llx stamp %llu completed %llu submitted %llu\n",
+        long(tv.tv_sec % 86400), int(tv.tv_usec / 1000), what, (unsigned long long)handle,
+        (unsigned long long)a, (unsigned long long)b, (unsigned long long)m_submitted.load());
+    }
+
+    dxvk::mutex           m_mutex;
+    std::deque<Entry>     m_entries;
+
+    void destroyNow(VkObjectType type, uint64_t handle) {
+      auto vk = m_vkd.ptr();
+
+      switch (type) {
+        case VK_OBJECT_TYPE_IMAGE:
+          vk->vkDestroyImage(vk->device(), VkImage(handle), nullptr);
+          break;
+        case VK_OBJECT_TYPE_IMAGE_VIEW:
+          vk->vkDestroyImageView(vk->device(), VkImageView(handle), nullptr);
+          break;
+        case VK_OBJECT_TYPE_BUFFER:
+          vk->vkDestroyBuffer(vk->device(), VkBuffer(handle), nullptr);
+          break;
+        case VK_OBJECT_TYPE_BUFFER_VIEW:
+          vk->vkDestroyBufferView(vk->device(), VkBufferView(handle), nullptr);
+          break;
+        case VK_OBJECT_TYPE_DEVICE_MEMORY:
+          vk->vkFreeMemory(vk->device(), VkDeviceMemory(handle), nullptr);
+          break;
+        default:
+          break;
+      }
+    }
+
+  };
+
+}
