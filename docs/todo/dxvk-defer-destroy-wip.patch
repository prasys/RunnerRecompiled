+
+  VkFence DxvkSubmissionQueue::acquireFence() {
+    { std::lock_guard lock(m_fenceMutex);
+
+      if (!m_fencePool.empty()) {
+        VkFence fence = m_fencePool.back();
+        m_fencePool.pop_back();
+        return fence;
+      }
+    }
+
+    auto vk = m_device->vkd();
+
+    VkFenceCreateInfo info = { VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+    VkFence fence = VK_NULL_HANDLE;
+
+    if (vk->vkCreateFence(vk->device(), &info, nullptr, &fence))
+      return VK_NULL_HANDLE;
+
+    return fence;
+  }
+
+
+  void DxvkSubmissionQueue::releaseFence(VkFence fence) {
+    auto vk = m_device->vkd();
+    vk->vkResetFences(vk->device(), 1, &fence);
+
+    std::lock_guard lock(m_fenceMutex);
+    m_fencePool.push_back(fence);
+  }
   
   
