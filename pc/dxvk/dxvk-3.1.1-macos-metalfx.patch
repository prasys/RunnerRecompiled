--- a/src/dxvk/dxvk_metalfx.mm
+++ b/src/dxvk/dxvk_metalfx.mm
@@ -0,0 +1,48 @@
+#import <Metal/Metal.h>
+#import <MetalFX/MetalFX.h>
+#include "dxvk_metalfx.h"
+#include <vulkan/vulkan_metal.h>
+#include <cstdlib>
+#include <cstring>
+#include <cstdio>
+
+namespace dxvk {
+bool tryMetalFxPresent(PFN_vkExportMetalObjectsEXT exportObjects, VkDevice device, VkQueue queue, VkImage source, VkImage destination,
+                       uint32_t iw, uint32_t ih, uint32_t ow, uint32_t oh) {
+  const char* mode = std::getenv("ME_PC_UPSCALER");
+  if (!mode || std::strcmp(mode, "metalfx")) return false;
+  VkExportMetalTextureInfoEXT src = { VK_STRUCTURE_TYPE_EXPORT_METAL_TEXTURE_INFO_EXT };
+  src.image = source; src.plane = VK_IMAGE_ASPECT_COLOR_BIT;
+  VkExportMetalTextureInfoEXT dst = { VK_STRUCTURE_TYPE_EXPORT_METAL_TEXTURE_INFO_EXT };
+  dst.image = destination; dst.plane = VK_IMAGE_ASPECT_COLOR_BIT;
+  src.pNext = &dst;
+  VkExportMetalCommandQueueInfoEXT q = { VK_STRUCTURE_TYPE_EXPORT_METAL_COMMAND_QUEUE_INFO_EXT };
+  q.queue = queue; q.pNext = &src;
+  VkExportMetalObjectsInfoEXT info = { VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECTS_INFO_EXT, &q };
+  if (!exportObjects) { std::fprintf(stderr, "DXVK MetalFX: blocked: vkExportMetalObjectsEXT unavailable\n"); return false; }
+  exportObjects(device, &info);
+  id<MTLTexture> in = (id<MTLTexture>)src.mtlTexture;
+  id<MTLTexture> drawable = (id<MTLTexture>)dst.mtlTexture;
+  id<MTLCommandQueue> metalQueue = (id<MTLCommandQueue>)q.mtlCommandQueue;
+  if (!in || !drawable || !metalQueue) { std::fprintf(stderr, "DXVK MetalFX: blocked: MoltenVK returned nil queue/texture (src=%p dst=%p queue=%p)\n", src.mtlTexture, dst.mtlTexture, q.mtlCommandQueue); return false; }
+  MTLFXSpatialScalerDescriptor* desc = [MTLFXSpatialScalerDescriptor new];
+  desc.inputWidth = iw; desc.inputHeight = ih; desc.outputWidth = ow; desc.outputHeight = oh;
+  desc.colorTextureFormat = MTLPixelFormatBGRA8Unorm; desc.outputTextureFormat = MTLPixelFormatBGRA8Unorm;
+  desc.colorProcessingMode = MTLFXSpatialScalerColorProcessingModePerceptual;
+  id<MTLDevice> metalDevice = metalQueue.device;
+  if (![MTLFXSpatialScalerDescriptor supportsDevice:metalDevice]) { std::fprintf(stderr, "DXVK MetalFX: blocked: MTLFXSpatialScalerDescriptor does not support exported device\n"); return false; }
+  id<MTLFXSpatialScaler> scaler = [desc newSpatialScalerWithDevice:metalDevice];
+  if (!scaler) { std::fprintf(stderr, "DXVK MetalFX: blocked: newSpatialScalerWithDevice returned nil\n"); return false; }
+  MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm width:ow height:oh mipmapped:NO];
+  td.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+  id<MTLTexture> output = [metalDevice newTextureWithDescriptor:td];
+  scaler.colorTexture = in; scaler.outputTexture = output;
+  id<MTLCommandBuffer> cb = [metalQueue commandBuffer];
+  [scaler encodeToCommandBuffer:cb];
+  id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+  [blit copyFromTexture:output sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0) sourceSize:MTLSizeMake(ow,oh,1) toTexture:drawable destinationSlice:0 destinationLevel:0 destinationOrigin:MTLOriginMake(0,0,0)];
+  [blit endEncoding]; [cb commit];
+  std::fprintf(stderr, "DXVK MetalFX: encoded %ux%u -> %ux%u\n", iw, ih, ow, oh);
+  return true;
+}
+}
