+ir::SsaDef ResourceMap::emitEmulatedDref(
+        ir::Builder&      builder,
+        SamplerStateType  textureType,
+        ir::SsaDef        descriptor,
+        ir::SsaDef        sampler,
+        ir::SsaDef        texCoord,
+        ir::SsaDef        lod,
+        ir::SsaDef        lodBias,
+        ir::SsaDef        dx,
+        ir::SsaDef        dy,
+        ir::SsaDef        reference) {
+  /* Depth compare without a Dref instruction, so the image keeps a colour
+   * declaration (see Options::emulateDepthCompare). D3D9 shadow samplers
