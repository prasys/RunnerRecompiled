+  // ---- Pipeline warm-up (macOS/MoltenVK patch) ----
+  // File: "MEPW", u32 version, u32 sizeof(state); then records of
+  // u16 vsLen, u16 fsLen, vs name, fs name, state bytes.
+
+  static constexpr uint32_t WarmVersion = 2;  // 2: records carry the map they were used in
+
+  static std::string warmKey(const std::string& vs, const std::string& fs,
+      const DxvkGraphicsPipelineStateInfo& state, const std::string& map) {
+    std::string k = map;
+    k.push_back('|');
+    k += vs;
+    k.push_back('|');
+    k += fs;
+    k.push_back('|');
+    k.append(reinterpret_cast<const char*>(&state), sizeof(state));
+    return k;
+  }
