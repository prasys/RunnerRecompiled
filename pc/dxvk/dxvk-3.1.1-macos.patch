+
+  void DxvkPipelineManager::warmShaderRegistered(const Rc<DxvkShader>& shader) {
+    if (!m_warmEnabled)
+      return;
+
+    std::string name = shader->debugName();
+
+    struct Job {
+      Rc<DxvkShader>                vs, fs;
+      DxvkGraphicsPipelineStateInfo state;
+    };
+    std::vector<Job> jobs;
+
+    { std::lock_guard<dxvk::mutex> lock(m_warmMutex);
+      m_warmShaders[name] = shader;
+
+      auto it = m_warmByShader.find(name);
+      if (it == m_warmByShader.end())
+        return;
+
+      for (size_t index : it->second) {
+        WarmRecord& rec = m_warmRecords[index];
+        if (rec.queued || !(rec.map.empty() || rec.map == m_warmMap))
+          continue;
+
+        auto vs = m_warmShaders.find(rec.vs);
+        if (vs == m_warmShaders.end())
+          continue;
+
+        Rc<DxvkShader> fs;
+        if (!rec.fs.empty()) {
+          auto fi = m_warmShaders.find(rec.fs);
+          if (fi == m_warmShaders.end())
+            continue;
+          fs = fi->second;
+        }
+
+        rec.queued = true;
+        m_warmQueued++;
+        jobs.push_back({ vs->second, fs, rec.state });
+      }
+    }
+
+    for (auto& job : jobs) {
+      DxvkGraphicsPipelineShaders shaders;
+      shaders.vs = job.vs;
+      shaders.fs = job.fs;
+
+      if (auto* pipeline = createGraphicsPipeline(shaders))
+        m_workers.compileGraphicsPipeline(pipeline, job.state, DxvkPipelinePriority::Normal);
+    }
+  }
+
+
+  void DxvkPipelineManager::setWarmMap(const std::string& map) {
+    if (!m_warmEnabled)
+      return;
+
+    struct Job {
+      Rc<DxvkShader>                vs, fs;
+      DxvkGraphicsPipelineStateInfo state;
+    };
+    std::vector<Job> jobs;
+    size_t total = 0;
+
+    { std::lock_guard<dxvk::mutex> lock(m_warmMutex);
+      if (m_warmMap == map)
+        return;
+      m_warmMap = map;
+
+      // Everything recorded for this map whose shaders already exist. The rest
+      // is queued by warmShaderRegistered() as its shaders appear.
+      auto it = m_warmByMap.find(map);
+      if (it != m_warmByMap.end()) {
+        total = it->second.size();
+        for (size_t index : it->second) {
+          WarmRecord& rec = m_warmRecords[index];
+          if (rec.queued)
+            continue;
+          auto vs = m_warmShaders.find(rec.vs);
+          if (vs == m_warmShaders.end())
+            continue;
+          Rc<DxvkShader> fs;
+          if (!rec.fs.empty()) {
+            auto fi = m_warmShaders.find(rec.fs);
+            if (fi == m_warmShaders.end())
+              continue;
+            fs = fi->second;
+          }
+          rec.queued = true;
+          m_warmQueued++;
+          jobs.push_back({ vs->second, fs, rec.state });
+        }
+      }
+    }
+
+    // Build the map's shaders now, on a helper thread, so that their pipelines compile
+    // while the game is still loading its assets. Creating a shader registers it, which
+    // queues the recorded pipelines whose shaders are complete (warmShaderRegistered).
+    std::vector<std::pair<bool, std::vector<uint8_t>>> early;
+    { std::lock_guard<dxvk::mutex> lock(m_warmMutex);
+      std::unordered_set<std::string> wanted;
+      auto it = m_warmByMap.find(map);
+      if (it != m_warmByMap.end()) {
+        for (size_t index : it->second) {
+          const WarmRecord& rec = m_warmRecords[index];
+          for (const std::string* n : { &rec.vs, &rec.fs }) {
+            if (n->empty() || m_warmShaders.count(*n) || !wanted.insert(*n).second)
+              continue;
+            auto src = m_warmSources.find(*n);
+            if (src != m_warmSources.end())
+              early.emplace_back(src->second.pixel, src->second.code);
+          }
+        }
+      }
+    }
+
+    static const bool earlyOff = [] { const char* e = std::getenv("DXVK_PIPELINE_WARM_EARLY"); return e && e[0] == '0'; }();
+
+    Logger::info(str::format("Pipeline warm-up: map ", map, ": ", total, " recorded states, ", jobs.size(),
+      " queued now, ", early.size(), " shaders to build early", earlyOff ? " (disabled)" : ""));
+
+    if (!early.empty() && !earlyOff) {
+      dxvk::thread([this, early = std::move(early)] {
+        env::setThreadName("dxvk-warm-early");
+        for (const auto& e : early) {
+          std::lock_guard<dxvk::mutex> lock(m_warmFactoryMutex);
+          if (!m_warmFactory)
+            return;
+          m_warmFactory(e.first, e.second);
+        }
+        Logger::info("Pipeline warm-up: early shader creation finished");
+      }).detach();
+    }
+
+    for (auto& job : jobs) {
+      DxvkGraphicsPipelineShaders shaders;
+      shaders.vs = job.vs;
+      shaders.fs = job.fs;
