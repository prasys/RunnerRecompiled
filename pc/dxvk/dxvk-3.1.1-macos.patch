+ir::SsaDef ResourceMap::emitEmulatedDref(
+        ir::Builder&      builder,
+        SamplerStateType  textureType,
+        ir::SsaDef        descriptor,
+        ir::SsaDef        sampler,
+        ir::SsaDef        texCoord,
+        ir::SsaDef        lod,
+        ir::SsaDef        lodBias,
+        ir::SsaDef        dx,
+        ir::SsaDef        dy,
+        ir::SsaDef        reference) {
+  /* Depth compare without a Dref instruction, so the image keeps a colour
+   * declaration (see Options::emulateDepthCompare). D3D9 shadow samplers
+   * compare with LESS_OR_EQUAL: a texel passes if reference <= depth. The
+   * sampler must not have compare enabled (the device clears it then). */
+  auto f32 = ir::ScalarType::eF32;
+  auto vec2Type = ir::BasicType(f32, 2u);
+  auto vec4Type = ir::BasicType(f32, 4u);
+  auto one = builder.makeConstant(1.0f);
+  auto zero = builder.makeConstant(0.0f);
+
+  auto compare = [&] (ir::SsaDef depth) {
+    auto pass = builder.add(ir::Op::FLe(ir::ScalarType::eBool, reference, depth));
+    return builder.add(ir::Op::Select(f32, pass, one, zero));
+  };
+
+  if (textureType != SamplerStateType::eTexture2D || lod || dx) {
+    /* Cube maps and explicit LOD or gradients: one filtered sample, then the
+     * compare. Loses percentage-closer filtering, keeps the result right. */
+    auto texel = builder.add(ir::Op::ImageSample(vec4Type, descriptor, sampler,
+      ir::SsaDef(), texCoord, ir::SsaDef(), lod, lodBias, ir::SsaDef(), dx, dy, ir::SsaDef()));
+    return compare(ir::extractFromVector(builder, texel, 0u));
+  }
+
+  /* 2D: percentage-closer filtering by hand. Gather the 2x2 depth footprint,
+   * compare each texel and weight the results bilinearly, which is what a
+   * linear-filtered compare sampler does. */
+  auto sizeType = ir::Type()
+    .addStructMember(ir::ScalarType::eU32, 2u)  /* size   */
+    .addStructMember(ir::ScalarType::eU32);     /* layers */
+
+  auto sizeStruct = builder.add(ir::Op::ImageQuerySize(sizeType, descriptor, builder.makeConstant(0u)));
+  auto sizeF = builder.add(ir::Op::ConvertItoF(vec2Type, ir::extractFromVector(builder, sizeStruct, 0u)));
+
+  auto halfTexel = broadcastScalar(builder, builder.makeConstant(0.5f), util::makeWriteMaskForComponents(2u));
+  auto texelPos = builder.add(ir::Op::FSub(vec2Type,
+    builder.add(ir::Op::FMul(vec2Type, texCoord, sizeF)), halfTexel));
+  auto weights = builder.add(ir::Op::FFract(vec2Type, texelPos));
+  auto wx = ir::extractFromVector(builder, weights, 0u);
+  auto wy = ir::extractFromVector(builder, weights, 1u);
+
+  auto texels = builder.add(ir::Op::ImageGather(vec4Type, descriptor, sampler,
+    ir::SsaDef(), texCoord, ir::SsaDef(), ir::SsaDef(), 0u));
+
+  /* Gather order: x = (i0, j1), y = (i1, j1), z = (i1, j0), w = (i0, j0) */
+  std::array<ir::SsaDef, 4u> passed;
+
+  for (uint32_t i = 0u; i < 4u; i++)
+    passed[i] = compare(ir::extractFromVector(builder, texels, i));
+
+  auto lerp = [&] (ir::SsaDef a, ir::SsaDef b, ir::SsaDef t) {
+    return builder.add(ir::Op::FMad(f32, builder.add(ir::Op::FSub(f32, b, a)), t, a));
+  };
+
+  auto row0 = lerp(passed[3u], passed[2u], wx);
+  auto row1 = lerp(passed[0u], passed[1u], wx);
+  return lerp(row0, row1, wy);
+}
