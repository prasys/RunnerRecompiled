diff --git a/src/wsi/sdl3/wsi_window_sdl3.cpp b/src/wsi/sdl3/wsi_window_sdl3.cpp
index f7dd35ab..92e675b8 100644
--- a/src/wsi/sdl3/wsi_window_sdl3.cpp
+++ b/src/wsi/sdl3/wsi_window_sdl3.cpp
@@ -180,6 +180,22 @@ namespace dxvk::wsi {
           VkSurfaceKHR*             pSurface) {
     SDL_Window* window = fromHwnd(hWindow);
 
+#if defined(__APPLE__)
+    // SDL creates the Metal view and CAMetalLayer for the surface inside this call. Cocoa wants that on the main
+    // thread; created from another thread the window stays black although frames are presented. The application
+    // must keep pumping SDL events on the main thread.
+    if (!SDL_IsMainThread()) {
+      struct Req { pfn_SDL_Vulkan_CreateSurface fn; SDL_Window* window; VkInstance instance; VkSurfaceKHR* surface; bool ok; };
+      Req req = { SDL_Vulkan_CreateSurface, window, instance, pSurface, false };
+      if (!SDL_RunOnMainThread([](void* p) {
+            Req* r = static_cast<Req*>(p);
+            r->ok = r->fn(r->window, r->instance, nullptr, r->surface);
+          }, &req, true))
+        return VK_ERROR_OUT_OF_HOST_MEMORY;
+      return req.ok ? VK_SUCCESS : VK_ERROR_OUT_OF_HOST_MEMORY;
+    }
+#endif
+
     return SDL_Vulkan_CreateSurface(window, instance, nullptr, pSurface)
       ? VK_SUCCESS : VK_ERROR_OUT_OF_HOST_MEMORY;
   }
