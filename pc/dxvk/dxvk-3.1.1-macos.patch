+
+  void DxvkPipelineManager::waitForWarmup() {
+    // Hold the present while shader and pipeline compiles are queued, so the
+    // game sits on its loading screen instead of stuttering. Bounded.
+    static const long limitMs = [] {
+      const char* e = std::getenv("DXVK_PIPELINE_WARM_WAIT_MS");
+      return e ? std::atol(e) : 10000L;
+    }();
+
+    if (!m_warmEnabled || limitMs <= 0 || m_warmQueued == 0)
+      return;
+
+    // Do not hold while the game is still on its loading screen (a handful of draws
+    // per frame): holding there stalls the loading thread, which delays the shaders
+    // the replay is waiting for. Hold once the scene is drawing.
+    static const uint64_t minDraws = [] {
+      const char* e = std::getenv("DXVK_PIPELINE_WARM_HOLD_DRAWS");
+      return e ? uint64_t(std::atol(e)) : uint64_t(0);  // 0 = hold on the loading screen too (measured: holding only in the scene trades one long freeze for several 0.5-1 s hitches)
+    }();
+
+    if (minDraws) {
+      static uint64_t lastDraws = 0;
+      uint64_t draws = m_device->getStatCounters().getCtr(DxvkStatCounter::CmdDrawCalls);
+      uint64_t frameDraws = draws - lastDraws;
+      lastDraws = draws;
+
+      if (frameDraws < minDraws)
+        return;
+    }
+
+    auto stats = m_workers.getStats();
+    if (stats.tasksCompleted >= stats.tasksTotal)
+      return;
+
+    // Only hold for a big backlog (a level load). A few queued compiles run in the
+    // background; holding the present for them just turns each into a 100+ ms hitch.
+    static const uint64_t minTasks = [] {
+      const char* e = std::getenv("DXVK_PIPELINE_WARM_HOLD_MIN");
+      return e ? uint64_t(std::atol(e)) : uint64_t(20);
+    }();
+
+    uint64_t pending = stats.tasksTotal - stats.tasksCompleted;
+    if (pending < minTasks)
+      return;
+
+    auto t0 = std::chrono::steady_clock::now();
+    long waited = 0;
+
+    while (waited < limitMs) {
+      stats = m_workers.getStats();
+      if (stats.tasksCompleted >= stats.tasksTotal)
+        break;
+      std::this_thread::sleep_for(std::chrono::milliseconds(2));
+      waited = long(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now() - t0).count());
+    }
+
+    if (waited >= 20)
+      Logger::info(str::format("Pipeline warm-up: held present ", waited, " ms for ", pending, " tasks"));
+  }
+
+
+  void DxvkPipelineManager::recordPipelineState(
+    const DxvkGraphicsPipelineShaders&    shaders,
+    const DxvkGraphicsPipelineStateInfo&  state) {
+    if (!m_warmEnabled || !shaders.vs || shaders.tcs || shaders.tes || shaders.gs)
+      return;
+
+    std::string vs = shaders.vs->debugName();
+    std::string fs = shaders.fs ? shaders.fs->debugName() : std::string();
+
+    if (vs.size() > 0xFFFF || fs.size() > 0xFFFF)
+      return;
+
+    std::lock_guard<dxvk::mutex> lock(m_warmMutex);
+
+    if (!m_warmSeen.insert(warmKey(vs, fs, state, m_warmMap)).second)
+      return;
+
+    FILE* f = std::fopen(m_warmPath.c_str(), "ab");
+    if (!f)
+      return;
+
+    { // wall-clock time so a play session can be mapped onto recorded states
+      std::time_t now = std::time(nullptr);
+      char tbuf[16];
+      std::strftime(tbuf, sizeof tbuf, "%H:%M:%S", std::localtime(&now));
+      Logger::info(str::format("Pipeline recorded #", m_warmSeen.size(), " at ", tbuf, " (", vs, " / ", fs, ")"));
+    }
+
+    uint16_t vsLen = uint16_t(vs.size()), fsLen = uint16_t(fs.size()), mapLen = uint16_t(m_warmMap.size());
+    std::fwrite(&vsLen, 2, 1, f);
+    std::fwrite(&fsLen, 2, 1, f);
+    std::fwrite(&mapLen, 2, 1, f);
+    std::fwrite(vs.data(), 1, vs.size(), f);
+    std::fwrite(fs.data(), 1, fs.size(), f);
+    std::fwrite(m_warmMap.data(), 1, m_warmMap.size(), f);
+    std::fwrite(&state, sizeof(state), 1, f);
+    std::fclose(f);
+
+    // Keep the bytecode of both shaders so the next run can build them early
+    for (const std::string* n : { &vs, &fs }) {
+      auto it = m_warmSources.find(*n);
+      if (n->empty() || it == m_warmSources.end() || it->second.saved)
+        continue;
+      FILE* sf = std::fopen((m_warmPath + ".shaders").c_str(), "ab");
+      if (!sf)
+        break;
+      uint16_t nameLen = uint16_t(n->size());
+      uint8_t pixel = it->second.pixel ? 1 : 0;
+      uint32_t size = uint32_t(it->second.code.size());
+      std::fwrite(&nameLen, 2, 1, sf);
+      std::fwrite(&pixel, 1, 1, sf);
+      std::fwrite(&size, 4, 1, sf);
+      std::fwrite(n->data(), 1, n->size(), sf);
+      std::fwrite(it->second.code.data(), 1, size, sf);
+      std::fclose(sf);
+      it->second.saved = true;
+    }
+  }
+
+
+  void DxvkPipelineManager::noteWarmShaderSource(const std::string& name, bool pixel, const void* code, size_t size) {
+    if (!m_warmEnabled || !code || !size)
+      return;
+
+    std::lock_guard<dxvk::mutex> lock(m_warmMutex);
+    auto it = m_warmSources.find(name);
+    if (it != m_warmSources.end())
+      return;
+
+    WarmSource src;
+    src.pixel = pixel;
+    src.code.assign(static_cast<const uint8_t*>(code), static_cast<const uint8_t*>(code) + size);
+    m_warmSources.emplace(name, std::move(src));
+  }
