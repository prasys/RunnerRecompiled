+  void DxvkPipelineManager::warmLoad() {
+    const char* off = std::getenv("DXVK_PIPELINE_WARM");
+    if (off && off[0] == '0')
+      return;
+
+    const char* path = std::getenv("DXVK_PIPELINE_WARM_FILE");
+    std::string file;
+
+    if (path && path[0]) {
+      file = path;
+    } else {
+      const char* home = std::getenv("HOME");
+      if (!home || !home[0])
+        return;
+      file = std::string(home) + "/.cache/dxvk/pipelines.warm";
+    }
+
+    m_warmPath = file;
+    m_warmEnabled = true;
+
+    FILE* f = std::fopen(file.c_str(), "rb");
+    bool valid = false;
+    size_t loaded = 0;
+
+    if (f) {
+      char magic[4];
+      uint32_t version = 0, stateSize = 0;
+      if (std::fread(magic, 1, 4, f) == 4 && !std::memcmp(magic, "MEPW", 4)
+       && std::fread(&version, 4, 1, f) == 1 && std::fread(&stateSize, 4, 1, f) == 1
+       && version == WarmVersion && stateSize == sizeof(DxvkGraphicsPipelineStateInfo)) {
+        valid = true;
+
+        while (true) {
+          uint16_t vsLen = 0, fsLen = 0, mapLen = 0;
+          if (std::fread(&vsLen, 2, 1, f) != 1 || std::fread(&fsLen, 2, 1, f) != 1
+           || std::fread(&mapLen, 2, 1, f) != 1)
+            break;
+
+          WarmRecord rec;
+          rec.vs.resize(vsLen);
+          rec.fs.resize(fsLen);
+          rec.map.resize(mapLen);
+
+          if ((vsLen && std::fread(&rec.vs[0], 1, vsLen, f) != vsLen)
+           || (fsLen && std::fread(&rec.fs[0], 1, fsLen, f) != fsLen)
+           || (mapLen && std::fread(&rec.map[0], 1, mapLen, f) != mapLen)
+           || std::fread(&rec.state, sizeof(rec.state), 1, f) != 1)
+            break;
+
+          if (!m_warmSeen.insert(warmKey(rec.vs, rec.fs, rec.state, rec.map)).second)
+            continue;
+
+          size_t index = m_warmRecords.size();
+          m_warmByMap[rec.map].push_back(index);
+          m_warmByShader[rec.vs].push_back(index);
+          if (!rec.fs.empty())
+            m_warmByShader[rec.fs].push_back(index);
+          m_warmRecords.push_back(std::move(rec));
+          loaded++;
+        }
+      }
+      std::fclose(f);
+    }
+
+    if (!valid) {
+      // New or incompatible file: start over (a version 1 file had no map tags, so
+      // it cannot be filtered by map; keep it next to the new one)
+      std::rename(file.c_str(), (file + ".old").c_str());
+      std::remove((file + ".shaders").c_str());
+      f = std::fopen(file.c_str(), "wb");
+      if (f) {
+        uint32_t version = WarmVersion, stateSize = sizeof(DxvkGraphicsPipelineStateInfo);
+        std::fwrite("MEPW", 1, 4, f);
+        std::fwrite(&version, 4, 1, f);
+        std::fwrite(&stateSize, 4, 1, f);
+        std::fclose(f);
+      } else {
+        m_warmEnabled = false;
+      }
+    }
+
+    { // shader bytecode saved next to the records
+      FILE* sf = std::fopen((file + ".shaders").c_str(), "rb");
+      size_t nsrc = 0;
+      if (sf) {
+        while (true) {
+          uint16_t nameLen = 0;
+          uint8_t pixel = 0;
+          uint32_t size = 0;
+          if (std::fread(&nameLen, 2, 1, sf) != 1 || std::fread(&pixel, 1, 1, sf) != 1
+           || std::fread(&size, 4, 1, sf) != 1 || size > (64u << 20))
+            break;
+          std::string name(nameLen, '\0');
+          WarmSource src;
+          src.pixel = pixel != 0;
+          src.saved = true;
+          src.code.resize(size);
+          if ((nameLen && std::fread(&name[0], 1, nameLen, sf) != nameLen)
+           || (size && std::fread(src.code.data(), 1, size, sf) != size))
+            break;
+          m_warmSources[name] = std::move(src);
+          nsrc++;
+        }
+        std::fclose(sf);
+      }
+      Logger::info(str::format("Pipeline warm-up: ", nsrc, " shader sources from ", file, ".shaders"));
+    }
+
+    Logger::info(str::format("Pipeline warm-up: ", loaded, " recorded states from ", file));
+  }
