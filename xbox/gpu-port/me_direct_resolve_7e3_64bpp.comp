#version 450
// Mirror's Edge port: direct resolve (T014) for the dominant resolve shape (2026-11-02, ~8 per
// frame): a 1x MSAA 2_10_10_10_FLOAT color render target copied with resolve_full_64bpp. Reads the
// host render target instead of the EDRAM buffer, so the EDRAM dump dispatch is skipped.
// Bit-identical to dump + resolve_full_64bpp: the sample is quantized as the dump does
// (UnclampedFloat32To7e3, alpha to 2 bits) and expanded as XeUnpackR10G10B10A2Float, then packed
// as XePack64bpp4Pixels with the resolve_full_64bpp addressing. Ported from Xenia's XeSL
// (resolve.xesli, pixel_formats.xesli, texture_address.xesli, endian.xesli); unscaled only.
// Build: glslc -O --target-env=vulkan1.0 -o me_direct_resolve_7e3_64bpp.spv <this file>
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// VulkanRenderTargetCache::DirectResolvePushConstants.
layout(push_constant) uniform XeDirectResolvePushConstants {
  uint edram_info;            // draw_util::ResolveEdramInfo
  uint coordinate_info;       // draw_util::ResolveCoordinateInfo
  uint dest_info;             // sanitized RB_COPY_DEST_INFO
  uint dest_coordinate_info;  // draw_util::ResolveCopyDestCoordinateInfo
  uint dest_base;
  uint source_base_tiles;     // base tile of the host render target
  uint source_pitch_tiles;    // its pitch in 32bpp tiles
  uint dispatch_first_tile;   // unused
} pc;

layout(set = 0, binding = 0, std430) writeonly buffer XeResolveDest { uvec4 xe_resolve_dest[]; };
layout(set = 1, binding = 0) uniform texture2D xe_resolve_source;

// HLSL saturate / GLSL.std.450 NClamp to [0, 1]: NaN becomes 0.
float SaturateN(float f) { return f > 0.0 ? min(f, 1.0) : 0.0; }

// SpirvShaderTranslator::UnclampedFloat32To7e3.
uint Float32To7e3(float f) {
  f = f > 0.0 ? min(f, 31.875) : 0.0;
  uint u = floatBitsToUint(f);
  uint denormal = ((u & 0x7FFFFFu) | 0x800000u) >> min(125u - (u >> 23u), 24u);
  uint normal = u - (124u << 23u);
  uint biased = u < 0x3E800000u ? denormal : normal;
  return ((biased + 0x7FFFu + ((biased >> 16u) & 1u)) >> 16u) & 0x3FFu;
}

// One component of XeUnpackR10G10B10A2Float.
float Float7e3To32(uint f10) {
  uint mantissa = f10 & 0x7Fu;
  uint exponent = f10 >> 7u;
  if (exponent == 0u) {
    uint lzcnt = 7u - uint(findMSB(mantissa));
    exponent = 1u - lzcnt;
    mantissa = (mantissa << lzcnt) & 0x7Fu;
  }
  return f10 == 0u ? 0.0 : uintBitsToFloat(((exponent + 124u) << 23u) | (mantissa << 16u));
}

// EDRAM pixel of the resolve surface -> host render target texel (32bpp, 1x MSAA: 80x16 tiles).
vec4 LoadSource(uvec2 p, uint edram_base_tiles, uint edram_pitch_tiles) {
  uint tile = edram_base_tiles + (p.y >> 4u) * edram_pitch_tiles + p.x / 80u;
  uint rt_tile = (tile - pc.source_base_tiles) & 2047u;
  uint rt_tile_y = rt_tile / pc.source_pitch_tiles;
  uint rt_tile_x = rt_tile - rt_tile_y * pc.source_pitch_tiles;
  ivec2 texel = ivec2(int(rt_tile_x * 80u + p.x % 80u), int((rt_tile_y << 4u) | (p.y & 15u)));
  return texelFetch(xe_resolve_source, texel, 0);
}

vec4 ResolveSample(vec4 source, float exp_bias, bool swap) {
  vec4 color = vec4(Float7e3To32(Float32To7e3(source.r)), Float7e3To32(Float32To7e3(source.g)),
                    Float7e3To32(Float32To7e3(source.b)),
                    float(uint(SaturateN(source.a) * 3.0 + 0.5)) * (1.0 / 3.0));
  color *= exp_bias;
  return swap ? color.bgra : color;
}

uvec2 Pack64bpp(vec4 f, uint format) {
  if (format == 21u || format == 26u) {  // k_16_16_16_16_EDRAM, k_16_16_16_16
    vec4 s = vec4(SaturateN(f.r), SaturateN(f.g), SaturateN(f.b), SaturateN(f.a));
    uvec4 n = uvec4(s * 65535.0 + 0.5);
    return n.rb | (n.ga << 16u);
  }
  if (format == 32u) {  // k_16_16_16_16_FLOAT
    return uvec2(packHalf2x16(f.rg), packHalf2x16(f.ba));
  }
  return floatBitsToUint(f.rg);  // treated as 32_32_FLOAT
}

uvec4 EndianSwap32(uvec4 v, uint endian) {
  if (endian == 1u || endian == 2u) v = ((v & 0x00FF00FFu) << 8u) | ((v & 0xFF00FF00u) >> 8u);
  if (endian == 2u || endian == 3u) v = (v << 16u) | (v >> 16u);
  return v;
}
uvec4 EndianSwap64(uvec4 v, uint endian) {
  if (endian == 4u) {
    v = v.yxwz;
    endian = 2u;
  }
  return EndianSwap32(v, endian);
}

int TiledAddressCombine(int outer_inner_bytes, int bank, int pipe, int y_lsb) {
  return (y_lsb << 4) | (pipe << 6) | (bank << 11) | (outer_inner_bytes & 0xF) |
         (((outer_inner_bytes >> 4) & 0x1) << 5) | (((outer_inner_bytes >> 5) & 0x7) << 8) |
         (outer_inner_bytes >> 8 << 12);
}
int TiledAddress2D(ivec2 p, uint pitch_macro_tiles, uint bytes_per_block_log2) {
  int outer_blocks = ((p.y >> 5) * int(pitch_macro_tiles) + (p.x >> 5)) << 6;
  int inner_blocks = (((p.y >> 1) & 0x7) << 3) | (p.x & 0x7);
  int outer_inner_bytes = (outer_blocks | inner_blocks) << bytes_per_block_log2;
  int bank = (p.y >> 4) & 0x1;
  int pipe = ((p.x >> 3) & 0x3) ^ (((p.y >> 3) & 0x1) << 1);
  return TiledAddressCombine(outer_inner_bytes, bank, pipe, p.y & 1);
}
int TiledAddressXInMacroXor(int x, uint bytes_per_block_log2) {
  return TiledAddressCombine((x & 0x7) << bytes_per_block_log2, 0, (x >> 3) & 0x3, 0);
}

void main() {
  uint edram_pitch_tiles = pc.edram_info & 1023u;
  uint edram_base_tiles = (pc.edram_info >> 13u) & 2047u;
  uvec2 edram_offset = uvec2((pc.coordinate_info & 15u) << 3u, ((pc.coordinate_info >> 4u) & 1u) << 3u);
  uint width_div_8 = (pc.coordinate_info >> 5u) & 2047u;
  uint dest_endian = pc.dest_info & 7u;
  uint dest_format = (pc.dest_info >> 7u) & 63u;
  float exp_bias = intBitsToFloat((int(pc.dest_info) << 10 >> 26 << 23) + floatBitsToInt(1.0));
  bool dest_swap = (pc.dest_info & (1u << 24u)) != 0u;
  uint dest_row_pitch_macro_tiles = pc.dest_coordinate_info & 1023u;
  uvec2 dest_xy_offset = ((uvec2(pc.dest_coordinate_info) >> uvec2(20u, 24u)) & 15u) << 3u;

  // 1 thread = 4 host pixels, as resolve_full_64bpp.
  uvec2 pixel_index = gl_GlobalInvocationID.xy << uvec2(2u, 0u);
  if (pixel_index.x >= width_div_8 << 3u) return;
  uvec2 source = pixel_index + edram_offset;
  vec4 pixel_0 = ResolveSample(LoadSource(source, edram_base_tiles, edram_pitch_tiles), exp_bias, dest_swap);
  vec4 pixel_1 = ResolveSample(LoadSource(source + uvec2(1u, 0u), edram_base_tiles, edram_pitch_tiles), exp_bias, dest_swap);
  vec4 pixel_2 = ResolveSample(LoadSource(source + uvec2(2u, 0u), edram_base_tiles, edram_pitch_tiles), exp_bias, dest_swap);
  vec4 pixel_3 = ResolveSample(LoadSource(source + uvec2(3u, 0u), edram_base_tiles, edram_pitch_tiles), exp_bias, dest_swap);
  uvec4 packed_01 = uvec4(Pack64bpp(pixel_0, dest_format), Pack64bpp(pixel_1, dest_format));
  uvec4 packed_23 = uvec4(Pack64bpp(pixel_2, dest_format), Pack64bpp(pixel_3, dest_format));

  uint dest_address = uint(TiledAddress2D(ivec2(pixel_index + dest_xy_offset), dest_row_pitch_macro_tiles, 3u)) + pc.dest_base;
  xe_resolve_dest[dest_address >> 4u] = EndianSwap64(packed_01, dest_endian);
  dest_address += uint(TiledAddressXInMacroXor(2, 3u));
  xe_resolve_dest[dest_address >> 4u] = EndianSwap64(packed_23, dest_endian);
}
